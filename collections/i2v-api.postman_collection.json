{
  "info": {
    "name": "i2v.ai Media API",
    "description": "Quote before submitting, submit inside a USD ceiling, and recover a submission with its idempotency key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.i2v.ai"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "model",
      "value": "gpt-image-2"
    },
    {
      "key": "idempotencyKey",
      "value": "postman-op-1"
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "maxCostUsd",
      "value": "0.20"
    },
    {
      "key": "expectedRevision",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List models (public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/generation-models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "generation-models"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account"
              ]
            }
          }
        },
        {
          "name": "Usage (30 days, UTC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/usage?range=30d",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account",
                "usage"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "30d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Generation",
      "item": [
        {
          "name": "Quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('expectedRevision', String(body.expectedRevision));",
                  "pm.test('quote has a USD maximum', () => pm.expect(body.maximum.currency).to.eql('USD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"inputs\": {\n    \"prompt\": \"A ceramic mug on an oak table\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "quote"
              ]
            }
          }
        },
        {
          "name": "Create task (needs approved ceiling)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.taskId) pm.collectionVariables.set('taskId', body.taskId);",
                  "pm.test('accepted with a task ID', () => pm.expect(body.taskId).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"inputs\": {\n    \"prompt\": \"A ceramic mug on an oak table\"\n  },\n  \"maxCostUsd\": \"{{maxCostUsd}}\",\n  \"expectedRevision\": \"{{expectedRevision}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/createTask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "createTask"
              ]
            }
          }
        },
        {
          "name": "Receipt by idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/submission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "submission"
              ]
            }
          }
        },
        {
          "name": "Task status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/recordInfo?taskId={{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "recordInfo"
              ],
              "query": [
                {
                  "key": "taskId",
                  "value": "{{taskId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": \"{{taskId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Request upload ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('uploadUrl', body.uploadUrl || '');",
                  "pm.collectionVariables.set('assetId', body.assetId || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"reference.png\",\n  \"fileSize\": 1024,\n  \"contentType\": \"image/png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "assets"
              ]
            }
          }
        },
        {
          "name": "Complete upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/assets/{{assetId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "assets",
                "{{assetId}}",
                "complete"
              ]
            }
          }
        }
      ]
    }
  ]
}
